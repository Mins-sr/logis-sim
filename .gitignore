# Local configuration and secrets; keep the safe configuration example.
.env
.env.*
config/env/.env
config/env/.env.*
!config/env/.env.example
*.pem
*.key

# All generated runtime, dependency, build, cache, data, log, and ledger files.
.local/
.venv*/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.coverage*
htmlcov/
*.db
*.db-*
*.sqlite
*.sqlite3
*.sqlite3-*
backups/

# Frontend build output and dependencies (legacy paths are ignored too).
node_modules/
dist/
*.tsbuildinfo
config/frontend/node_modules/
config/frontend/dist/

# Local verification logs and manual usage ledger (back up separately).
*.log
.DS_Store

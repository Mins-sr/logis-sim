POSTGRES_DB=slapstack
POSTGRES_USER=slapstack
POSTGRES_PASSWORD=slapstack-local-only
# Host-side migrations connect through the published Postgres loopback port.
DATABASE_URL=postgresql+psycopg://slapstack:slapstack-local-only@127.0.0.1:5432/slapstack
OPTIMIZER_URL=http://optimizer:8001
ALLOWED_ORIGIN=http://localhost:8080
PROXY_PORT=8080
# Local SQLite and service logs are kept under .local by scripts/dev.sh.
